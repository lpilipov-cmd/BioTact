# Javne Supabase vrednosti. Nikada ne unositi service-role ključ u NEXT_PUBLIC_* promenljivu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcioni javni broj za WhatsApp CTA, u međunarodnom formatu bez znaka +.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Serverska tajna za HMAC zaštitu javnog upita (najmanje 32 nasumična znaka).
# Ne koristiti NEXT_PUBLIC_ prefiks i ne unositi ovu vrednost u klijentski kod.
LEAD_RATE_LIMIT_SALT=
